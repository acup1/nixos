#!/usr/bin/env sh

# === Основной layout ===
yabai -m config layout bsp

# === Отступы (gaps 6 из niri) ===
yabai -m config top_padding     6
yabai -m config bottom_padding  6
yabai -m config left_padding    6
yabai -m config right_padding   6
yabai -m config window_gap      6

# === Фокус мыши (focus-follows-mouse + warp-mouse-to-focus из niri) ===
yabai -m config focus_follows_mouse  autofocus
yabai -m config mouse_follows_focus  on

# === Мышь: move + resize ===
yabai -m config mouse_modifier       fn
yabai -m config mouse_action1        move
yabai -m config mouse_action2        resize
yabai -m config mouse_drop_action    swap

# === Окна ===
yabai -m config window_placement     second_child
yabai -m config split_ratio          0.5
yabai -m config auto_balance         off

# === Бордер (border width 2 из niri) ===
yabai -m config window_border              on
yabai -m config window_border_width        2
# active-gradient from="#80c8ff" to="#c7ff7f" — берём средний цвет
yabai -m config active_window_border_color   "0xffa4e4bf"
# inactive-color "#505050"
yabai -m config normal_window_border_color   "0xff505050"
yabai -m config insert_feedback_color        "0xff9b0000"

# === Скругление углов (geometry-corner-radius 6) ===
# yabai сам не скругляет, но уважает системные настройки macOS

# === Тени (shadow из niri) ===
yabai -m config window_shadow on

# === Opacity off (niri не задаёт) ===
yabai -m config window_opacity           off
yabai -m config active_window_opacity    1.0
yabai -m config normal_window_opacity    1.0

# === Правила — floating окна (аналог open-floating true) ===
yabai -m rule --add app="^System Preferences$"  manage=off
yabai -m rule --add app="^System Information$"  manage=off
yabai -m rule --add app="^Activity Monitor$"    manage=off
yabai -m rule --add app="^Calculator$"          manage=off
yabai -m rule --add app="^Finder$"              manage=off
yabai -m rule --add app="^Archive Utility$"     manage=off
# Picture-in-Picture (open-floating true из niri)
yabai -m rule --add title="^Picture in Picture$" manage=off

echo "yabai config loaded"
